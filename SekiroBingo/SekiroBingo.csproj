		<Copy
		  SourceFiles="@(PublishAsset)"
		  DestinationFiles="@(PublishAsset->'$(PublishDir)AppData\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true" />
	</Target>-->
</Project>
