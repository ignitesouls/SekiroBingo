<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Content
		Include="Resources\me3\**\*.*"
		Exclude="Resources\me3\sekiro-bingo\mod\.smithbox\**\*.*;Resources\me3\sekiro-bingo\mod\recovery\**\*.*;Resources\me3\sekiro-bingo\mod\**\*.prev;Resources\me3\sekiro-bingo\mod\**\*.bak;Resources\me3\sekiro-bingo\mod\**\*.js*;"
		>
		<Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="PublishBingoQoL" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\BingoQoL\BingoQoL.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;PublishDir=$(MSBuildProjectDirectory)\..\BingoQoL\bin\$(Configuration)\native\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\BingoQoL\bin\$(Configuration)\native\BingoQoL.dll"
          DestinationFolder="$(MSBuildProjectDirectory)\Resources\me3\qol" />
    <ItemGroup>
      <Content Include="Resources\me3\qol\BingoQoL.dll" Condition="'@(Content->AnyHaveMetadataValue('Identity', 'Resources\me3\qol\BingoQoL.dll'))' != 'true'">
        <Link>qol\BingoQoL.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

	<!--<ItemGroup>
		<PublishAsset Include="Resources\me3" />
	</ItemGroup>

	<Target Name="CopyAssetsToPublishDir" AfterTargets="Publish">
